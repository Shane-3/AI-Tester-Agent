// Prisma Schema for AI Tester Agent
// Defines all core models: users, projects, stories, commits, tests, defects, risk reports

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  role      String    @default("tester") // admin, tester, developer, viewer
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  ProjectMember[]
}

model Project {
  id          String    @id @default(uuid())
  name        String
  repoUrl     String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  members     ProjectMember[]
  userStories UserStory[]
  commits     Commit[]
  testCases   TestCase[]
  testRuns    TestRun[]
  defects     Defect[]
  riskReports RiskReport[]
}

model ProjectMember {
  id        String  @id @default(uuid())
  userId    String
  projectId String
  role      String  @default("member") // owner, admin, member
  user      User    @relation(fields: [userId], references: [id])
  project   Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}

model UserStory {
  id                 String    @id @default(uuid())
  projectId          String
  externalId         String?   // Jira ticket ID
  title              String
  description        String
  acceptanceCriteria String[]
  edgeCases          String[]
  priority           String    @default("medium") // low, medium, high, critical
  businessCriticality Int      @default(5) // 1-10 scale
  status             String    @default("pending") // pending, analyzed, tested
  features           String[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  project            Project   @relation(fields: [projectId], references: [id])
  testCases          TestCase[]
}

model Commit {
  id              String    @id @default(uuid())
  projectId       String
  sha             String
  message         String
  author          String
  branch          String?
  filesChanged    String[]
  additions       Int       @default(0)
  deletions       Int       @default(0)
  impactedModules String[]
  riskScore       Int?      // 0-100
  analyzedAt      DateTime?
  createdAt       DateTime  @default(now())
  project         Project   @relation(fields: [projectId], references: [id])
  testRuns        TestRun[]
}

model TestCase {
  id           String    @id @default(uuid())
  projectId    String
  storyId      String?
  title        String
  description  String
  type         String    // functional, edge, api, ui
  priority     String    @default("medium")
  steps        String[]
  expectedResult String
  code         String?   // Generated test code (Playwright, API test, etc.)
  status       String    @default("generated") // generated, approved, executed, failed, passed
  isAutomated  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  project      Project   @relation(fields: [projectId], references: [id])
  userStory    UserStory? @relation(fields: [storyId], references: [id])
  testRunCases TestRunCase[]
}

model TestRun {
  id          String    @id @default(uuid())
  projectId   String
  commitId    String?
  name        String
  status      String    @default("pending") // pending, running, passed, failed
  totalTests  Int       @default(0)
  passedTests Int       @default(0)
  failedTests Int       @default(0)
  skippedTests Int      @default(0)
  duration    Int?      // milliseconds
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id])
  commit      Commit?   @relation(fields: [commitId], references: [id])
  testCases   TestRunCase[]
}

model TestRunCase {
  id         String   @id @default(uuid())
  testRunId  String
  testCaseId String
  status     String   @default("pending") // pending, passed, failed, skipped
  duration   Int?     // milliseconds
  errorLog   String?
  testRun    TestRun  @relation(fields: [testRunId], references: [id])
  testCase   TestCase @relation(fields: [testCaseId], references: [id])
}

model Defect {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  description String
  severity    String    @default("medium") // low, medium, high, critical
  module      String
  status      String    @default("open") // open, in-progress, resolved, closed
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id])
}

model RiskReport {
  id             String    @id @default(uuid())
  projectId      String
  riskScore      Int       // 0-100
  riskLevel      String    // low, medium, high
  factors        Json      // Array of risk factor objects
  recommendation String
  explanation    String
  deployment     String    @default("pending") // approved, blocked, pending
  createdAt      DateTime  @default(now())
  project        Project   @relation(fields: [projectId], references: [id])
}
